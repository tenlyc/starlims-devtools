		categoryDTO:IsMandatory := .F.;
		categoryDTO:ItemBehaviour := "merge";
		categoryDTO:ClientScripts := {};
		AAdd(packageDTO:ClientScriptCategories, categoryDTO);
	:ENDIF;

	itemDTO := DoProc("_GetArrayItemById", {categoryDTO:ClientScripts, aInfo[1][1]});
	:IF !Empty(itemDTO);
		:RETURN;
	:ENDIF;

	itemDTO := CreateUDObject("DEI_ManifestDTO.ClientScript");
	itemDTO:ItemID := aInfo[1][1];
	itemDTO:ItemName := aInfo[1][2];
	:IF !Empty(aInfo[1][3]);
		itemDTO:ItemDescription := aInfo[1][3];
	:ENDIF;
	itemDTO:ItemCategory := aInfo[1][4];
	itemDTO:LayerId := DoProc("_GetSafeLayerId", {aInfo[1][11]});
	itemDTO:ItemContent := sItemContent;
	itemDTO:IsMandatory := .F.;
	itemDTO:ItemBehaviour := "overwrite";
	itemDTO:ItemProgrammingLanguage := aInfo[1][5];
	itemDTO:ItemIsOwned := "N";
	itemDTO:IsReferred := .F.;
	AAdd(categoryDTO:ClientScripts, itemDTO);
:ENDPROC;

:PROCEDURE _AddDataSourceToPackage;
:PARAMETERS packageDTO, sItemId, sItemContent;

	:DECLARE nSysLayerId, aInfo, categoryDTO, itemDTO;
	nSysLayerId := GetSystemLayerId();
	aInfo := SqlExecute(
		"select s.DATASOURCEID, s.DISPLAYTEXT, s.DSDESCRIPTION, c.DISPLAYTEXT, s.SCRIPTLANGUAGE, c.CATEGORYID, c.DISPLAYTEXT, c.CATDESCRIPTION, c.ISSYSTEM, c.LAYERID, s.LAYERID " +
		"from LIMSDATASOURCES s inner join LIMSDATASOURCECATEGORIES c on s.CATEGORYID = c.CATEGORYID " +
		"where s.DATASOURCEID = ?sItemId? " +
		"order by case when s.LAYERID <= ?nSysLayerId? then ?nSysLayerId? - s.LAYERID else s.LAYERID end",
		"DICTIONARY"
	);

	:IF Empty(aInfo);
		:RETURN;
	:ENDIF;

	categoryDTO := DoProc("_GetArrayItemById", {packageDTO:DataSourceCategories, aInfo[1][6]});
	:IF Empty(categoryDTO);
		categoryDTO := CreateUDObject("DEI_ManifestDTO.DataSourceCategory");
		categoryDTO:ItemID := aInfo[1][6];
		categoryDTO:ItemName := aInfo[1][7];
		categoryDTO:ItemDescription := aInfo[1][8];
		categoryDTO:ItemIsSystem := aInfo[1][9];
		categoryDTO:LayerId := DoProc("_GetSafeLayerId", {aInfo[1][10]});
		categoryDTO:IsMandatory := .F.;
		categoryDTO:ItemBehaviour := "merge";
		categoryDTO:DataSourceScripts := {};
		AAdd(packageDTO:DataSourceCategories, categoryDTO);
	:ENDIF;

	itemDTO := DoProc("_GetArrayItemById", {categoryDTO:DataSourceScripts, aInfo[1][1]});
	:IF !Empty(itemDTO);
		:RETURN;
	:ENDIF;

	itemDTO := CreateUDObject("DEI_ManifestDTO.DataSourceScript");
	itemDTO:ItemID := aInfo[1][1];
	itemDTO:ItemName := aInfo[1][2];
	:IF !Empty(aInfo[1][3]);
		itemDTO:ItemDescription := aInfo[1][3];
	:ENDIF;
	itemDTO:ItemCategory := aInfo[1][4];
	itemDTO:LayerId := DoProc("_GetSafeLayerId", {aInfo[1][11]});
	itemDTO:ItemContent := sItemContent;
	itemDTO:IsMandatory := .F.;
	itemDTO:ItemBehaviour := "overwrite";
	itemDTO:ItemProgrammingLanguage := aInfo[1][5];
	itemDTO:ItemIsOwned := "N";
	itemDTO:IsReferred := .F.;
	itemDTO:IsOffline := "N";
	AAdd(categoryDTO:DataSourceScripts, itemDTO);
:ENDPROC;

:PROCEDURE _AddTableToPackage;
:PARAMETERS packageDTO, row, sItemContent;

	:DECLARE nSysLayerId, aInfo, sCategoryName, categoryDTO, itemDTO, sTableId;
	nSysLayerId := GetSystemLayerId();
	sTableId := row["CHILDID"];
	aInfo := SqlExecute(
		"select t.TABLEID, t.TABLENAME, t.LAYERID from LIMSTABLES t where t.TABLEID = ?sTableId? " +
		"order by case when t.LAYERID <= ?nSysLayerId? then ?nSysLayerId? - t.LAYERID else t.LAYERID end",
		"DICTIONARY"
	);

	:IF Empty(aInfo);
		:RETURN;
	:ENDIF;

	sCategoryName := Upper(row["PARENTNAME"]);
	categoryDTO := DoProc("_GetArrayItemById", {packageDTO:TableCategories, sCategoryName});
	:IF Empty(categoryDTO);
		categoryDTO := CreateUDObject("DEI_ManifestDTO.TableCategory");
		categoryDTO:ItemID := sCategoryName;
		categoryDTO:ItemName := sCategoryName;
		categoryDTO:ItemDescription := "Connection to " + sCategoryName;
		categoryDTO:ItemIsSystem := "Y";
		categoryDTO:LayerId := GetSystemLayerId();
		categoryDTO:IsMandatory := .F.;
		categoryDTO:ItemBehaviour := "merge";
		categoryDTO:Tables := {};
		AAdd(packageDTO:TableCategories, categoryDTO);
	:ENDIF;

	itemDTO := DoProc("_GetArrayItemById", {categoryDTO:Tables, aInfo[1][1]});
	:IF !Empty(itemDTO);
		:RETURN;
	:ENDIF;

	itemDTO := CreateUDObject("DEI_ManifestDTO.Table");
	itemDTO:ItemID := aInfo[1][1];
	itemDTO:ItemName := aInfo[1][2];
	itemDTO:ItemDescription := "";
	itemDTO:ItemCategory := sCategoryName;
	itemDTO:LayerId := DoProc("_GetSafeLayerId", {aInfo[1][3]});
	itemDTO:ItemContent := sItemContent;
	itemDTO:IsMandatory := .F.;
	itemDTO:ItemBehaviour := "merge";
	itemDTO:IsSystem := "Y";
	AAdd(categoryDTO:Tables, itemDTO);
:ENDPROC;

/* Returns the manifest XML for the package in the Designer/SCM_API format.
   The core Enterprise_Server.ManifestXmlFromPackageDTO.GetManifestXml
   serializer is unusable here: the SSL runtime marshals the DTO arrays as
   strings, so every collection item is emitted with a </string> closing tag
   which the target ImportManager cannot deserialize (itemDTO:LayerId ends up
   null and the import dies in ImportManager._getlayerid with "Argument
   'sNumber' cannot be null and it must be a string"). The <Package> format
   below is structurally identical to Designer exports and to the SCM_API
   package itself, which import without problems;
:PROCEDURE _ManifestToXml;
:PARAMETERS packageDTO;

	:DECLARE sXml, i, j, appCategory, application, lang, flag, tableCat, table, category;
	sXml := '<?xml version="1.0" encoding="utf-8"?>' + CrLf;
	sXml := sXml + '<Package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">' + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"ItemID", packageDTO:ItemID}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"ItemName", packageDTO:ItemName}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"PackageDate", packageDTO:PackageDate}) + CrLf;
	sXml := sXml + DoProc("_XmlEmptyElem", {"PathReadMe"}) + CrLf;
	sXml := sXml + DoProc("_XmlEmptyElem", {"PathEULA"}) + CrLf;
	sXml := sXml + DoProc("_XmlEmptyElem", {"PathLogo"}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"OverwriteLayer", "false"}) + CrLf;

	/* application categories;
	:IF Len(packageDTO:ApplicationCategories) == 0;
		sXml := sXml + DoProc("_XmlEmptyElem", {"ApplicationCategoryCollection"}) + CrLf;
	:ELSE;
		sXml := sXml + "<ApplicationCategoryCollection>" + CrLf;
		:FOR i := 1 :TO Len(packageDTO:ApplicationCategories);
			appCategory := packageDTO:ApplicationCategories[i];
			sXml := sXml + "<ApplicationCategory>" + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemID", appCategory:ItemID}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemName", appCategory:ItemName}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"LayerId", appCategory:LayerId}) + CrLf;
			sXml := sXml + DoProc("_XmlEmptyElem", {"ItemDescription"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemIsSystem", appCategory:ItemIsSystem}) + CrLf;
			:IF Len(appCategory:Applications) == 0;
				sXml := sXml + DoProc("_XmlEmptyElem", {"ApplicationCollection"}) + CrLf;
			:ELSE;
				sXml := sXml + "<ApplicationCollection>" + CrLf;
				:FOR j := 1 :TO Len(appCategory:Applications);
					application := appCategory:Applications[j];
					sXml := sXml + "<Application>" + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemID", application:ItemID}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemName", application:ItemName}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"LayerId", application:LayerId}) + CrLf;
					sXml := sXml + DoProc("_XmlEmptyElem", {"ItemDescription"}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemCategory", application:ItemCategory}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
					sXml := sXml + DoProc("_FormsXml", {application:Forms}) + CrLf;
					sXml := sXml + DoProc("_DataSourcesXml", {application:DataSources}) + CrLf;
					sXml := sXml + DoProc("_ServerScriptsXml", {application:ServerScripts}) + CrLf;
					sXml := sXml + DoProc("_ClientScriptsXml", {application:ClientScripts}) + CrLf;
					sXml := sXml + "</Application>" + CrLf;
				:NEXT;
				sXml := sXml + "</ApplicationCollection>" + CrLf;
			:ENDIF;
			sXml := sXml + "</ApplicationCategory>" + CrLf;
		:NEXT;
		sXml := sXml + "</ApplicationCategoryCollection>" + CrLf;
	:ENDIF;

	/* server script categories; 
	:IF Len(packageDTO:ServerScriptCategories) == 0;
		sXml := sXml + DoProc("_XmlEmptyElem", {"ServerScriptCategoryCollection"}) + CrLf;
	:ELSE;
		sXml := sXml + "<ServerScriptCategoryCollection>" + CrLf;
		:FOR i := 1 :TO Len(packageDTO:ServerScriptCategories);
			category := packageDTO:ServerScriptCategories[i];
			sXml := sXml + "<ServerScriptCategory>" + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemID", category:ItemID}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemName", category:ItemName}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"LayerId", category:LayerId}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemDescription", category:ItemDescription}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemIsSystem", category:ItemIsSystem}) + CrLf;
			sXml := sXml + DoProc("_ServerScriptsXml", {category:ServerScripts}) + CrLf;
			sXml := sXml + "</ServerScriptCategory>" + CrLf;
		:NEXT;
		sXml := sXml + "</ServerScriptCategoryCollection>" + CrLf;
	:ENDIF;

	/* client script categories; 
	:IF Len(packageDTO:ClientScriptCategories) == 0;
		sXml := sXml + DoProc("_XmlEmptyElem", {"ClientScriptCategoryCollection"}) + CrLf;
	:ELSE;
		sXml := sXml + "<ClientScriptCategoryCollection>" + CrLf;
		:FOR i := 1 :TO Len(packageDTO:ClientScriptCategories);
			category := packageDTO:ClientScriptCategories[i];
			sXml := sXml + "<ClientScriptCategory>" + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemID", category:ItemID}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemName", category:ItemName}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"LayerId", category:LayerId}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemDescription", category:ItemDescription}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemIsSystem", category:ItemIsSystem}) + CrLf;
			sXml := sXml + DoProc("_ClientScriptsXml", {category:ClientScripts}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"Hidden", "true"}) + CrLf;
			sXml := sXml + "</ClientScriptCategory>" + CrLf;
		:NEXT;
		sXml := sXml + "</ClientScriptCategoryCollection>" + CrLf;
	:ENDIF;

	/* data source categories; 
	:IF Len(packageDTO:DataSourceCategories) == 0;
		sXml := sXml + DoProc("_XmlEmptyElem", {"DataSourceCategoryCollection"}) + CrLf;
	:ELSE;
		sXml := sXml + "<DataSourceCategoryCollection>" + CrLf;
		:FOR i := 1 :TO Len(packageDTO:DataSourceCategories);
			category := packageDTO:DataSourceCategories[i];
			sXml := sXml + "<DataSourceCategory>" + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemID", category:ItemID}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemName", category:ItemName}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"LayerId", category:LayerId}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemDescription", category:ItemDescription}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemIsSystem", category:ItemIsSystem}) + CrLf;
			sXml := sXml + DoProc("_DataSourcesXml", {category:DataSourceScripts}) + CrLf;
			sXml := sXml + "</DataSourceCategory>" + CrLf;
		:NEXT;
		sXml := sXml + "</DataSourceCategoryCollection>" + CrLf;
	:ENDIF;

	/* languages with their flag images; 
	:IF Len(packageDTO:Languages) == 0;
		sXml := sXml + DoProc("_XmlEmptyElem", {"LanguageCollection"}) + CrLf;
	:ELSE;
		sXml := sXml + "<LanguageCollection>" + CrLf;
		:FOR i := 1 :TO Len(packageDTO:Languages);
			lang := packageDTO:Languages[i];
			flag := lang:ItemFlag;
			sXml := sXml + "<Language>" + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemID", lang:ItemID}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemName", lang:ItemName}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemDescription", lang:ItemDescription}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
			:IF Empty(flag);
				sXml := sXml + DoProc("_XmlEmptyElem", {"ItemFlag"}) + CrLf;
			:ELSE;
				sXml := sXml + "<ItemFlag>" + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ItemID", flag:ItemID}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ItemName", flag:ItemName}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"LayerId", flag:LayerId}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ItemDescription", flag:ItemDescription}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ItemCategory", flag:ItemCategory}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ItemContent", flag:ItemContent}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "overwrite"}) + CrLf;
				sXml := sXml + DoProc("_XmlEmptyElem", {"ImageType"}) + CrLf;
				sXml := sXml + DoProc("_XmlEmptyElem", {"ColorDepth"}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ImageHeight", "0"}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"ImageWidth", "0"}) + CrLf;
				sXml := sXml + DoProc("_XmlElem", {"Size", "0"}) + CrLf;
				sXml := sXml + "</ItemFlag>" + CrLf;
			:ENDIF;
			sXml := sXml + "</Language>" + CrLf;
		:NEXT;
		sXml := sXml + "</LanguageCollection>" + CrLf;
	:ENDIF;

	/* table categories; 
	:IF Len(packageDTO:TableCategories) == 0;
		sXml := sXml + DoProc("_XmlEmptyElem", {"TableCategoryCollection"}) + CrLf;
	:ELSE;
		sXml := sXml + "<TableCategoryCollection>" + CrLf;
		:FOR i := 1 :TO Len(packageDTO:TableCategories);
			tableCat := packageDTO:TableCategories[i];
			sXml := sXml + "<TableCategory>" + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemID", tableCat:ItemID}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemName", tableCat:ItemName}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"LayerId", tableCat:LayerId}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemDescription", tableCat:ItemDescription}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
			sXml := sXml + DoProc("_XmlElem", {"ItemIsSystem", tableCat:ItemIsSystem}) + CrLf;
			:IF Len(tableCat:Tables) == 0;
				sXml := sXml + DoProc("_XmlEmptyElem", {"TableCollection"}) + CrLf;
			:ELSE;
				sXml := sXml + "<TableCollection>" + CrLf;
				:FOR j := 1 :TO Len(tableCat:Tables);
					table := tableCat:Tables[j];
					sXml := sXml + "<Table>" + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemID", table:ItemID}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemName", table:ItemName}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"LayerId", table:LayerId}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemDescription", table:ItemDescription}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemCategory", table:ItemCategory}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemContent", table:ItemContent}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "merge"}) + CrLf;
					sXml := sXml + DoProc("_XmlElem", {"IsSystem", table:IsSystem}) + CrLf;
					sXml := sXml + "</Table>" + CrLf;
				:NEXT;
				sXml := sXml + "</TableCollection>" + CrLf;
			:ENDIF;
			sXml := sXml + "</TableCategory>" + CrLf;
		:NEXT;
		sXml := sXml + "</TableCategoryCollection>" + CrLf;
	:ENDIF;

	sXml := sXml + DoProc("_XmlEmptyElem", {"RequiredPackageCollection"}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"OverwriteCodeBehind", "true"}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"ImportGlobalResources", "true"}) + CrLf;
	sXml := sXml + DoProc("_XmlElem", {"CompareTables", "false"}) + CrLf;
	sXml := sXml + "</Package>" + CrLf;

	:RETURN sXml;
:ENDPROC;

:PROCEDURE _XmlElem;
:PARAMETERS sName, sValue;

	:DECLARE s;
	s := IIf(Empty(sValue), "", LimsString(sValue));
	s := StrTran(s, "&", "&amp;");
	s := StrTran(s, "<", "&lt;");
	s := StrTran(s, ">", "&gt;");
	:RETURN "<" + sName + ">" + s + "</" + sName + ">";
:ENDPROC;

:PROCEDURE _XmlEmptyElem;
:PARAMETERS sName;

	:RETURN "<" + sName + " />";
:ENDPROC;

:PROCEDURE _FormsXml;
:PARAMETERS aForms;

	:DECLARE sXml, i, form;
	:IF Len(aForms) == 0;
		:RETURN DoProc("_XmlEmptyElem", {"FormCollection"});
	:ENDIF;

	sXml := "<FormCollection>" + CrLf;
	:FOR i := 1 :TO Len(aForms);
		form := aForms[i];
		sXml := sXml + "<Form>" + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemID", form:ItemID}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemName", form:ItemName}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"LayerId", form:LayerId}) + CrLf;
		sXml := sXml + DoProc("_XmlEmptyElem", {"ItemDescription"}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemCategory", form:ItemCategory}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemContent", form:ItemContent}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "overwrite"}) + CrLf;
		sXml := sXml + DoProc("_XmlEmptyElem", {"ClientScripts"}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ModesOfOperationImportMode", form:ModesOfOperationImportMode}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"OverwriteTransactionSettings", IIf(form:OverwriteTransactionSettings, "true", "false")}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"FormType", form:FormType}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"IsOffline", "N"}) + CrLf;
		sXml := sXml + "</Form>" + CrLf;
	:NEXT;
	sXml := sXml + "</FormCollection>";

	:RETURN sXml;
:ENDPROC;

:PROCEDURE _ServerScriptsXml;
:PARAMETERS aScripts;

	:DECLARE sXml, i, script;
	:IF Len(aScripts) == 0;
		:RETURN DoProc("_XmlEmptyElem", {"ServerScriptCollection"});
	:ENDIF;

	sXml := "<ServerScriptCollection>" + CrLf;
	:FOR i := 1 :TO Len(aScripts);
		script := aScripts[i];
		sXml := sXml + "<ServerScript>" + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemID", script:ItemID}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemName", script:ItemName}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"LayerId", script:LayerId}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemDescription", script:ItemDescription}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemCategory", script:ItemCategory}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemContent", script:ItemContent}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"IsMandatory", "false"}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemBehaviour", "overwrite"}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemProgrammingLanguage", script:ItemProgrammingLanguage}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"ItemIsOwned", script:ItemIsOwned}) + CrLf;
		sXml := sXml + DoProc("_XmlElem", {"IsReferred", "false"}) + CrLf;
		sXml := sXml + "</ServerScript>" + CrLf;
	:NEXT;
	sXml := sXml + "</ServerScriptCollection>";

	:RETURN sXml;
:ENDPROC;

