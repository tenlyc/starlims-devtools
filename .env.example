# STARLIMS DevTools Environment Configuration

# AI models are configured in the MCP client (Codex, Claude Code, Cursor, etc.).
# STARLIMS DevTools exposes a local Streamable HTTP endpoint at:
# http://127.0.0.1:3002/mcp

# STARLIMS Bridge
STARLIMS_BRIDGE_URL=http://localhost:5468/

# Application
NODE_ENV=development
