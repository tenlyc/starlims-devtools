/********************************************************************************
Description.. :	Return the labels attached to an item from VERSIONSLABELS /
				VERSIONSLABELS_ITEMS (mirrors the official Source Control
				Manager dsGetLabelsForItem data source).
Parameters... :	- URI : enterprise item URI
Returns...... :	- { success, data: [ label rows ] }
Author....... :	STARLIMS DevTools
Date......... : 2026-08-29
********************************************************************************/;
:DECLARE oResponse, sURI, oUtils, oEnterpriseItem, sItemName, sItemType, sItemID,
		 sSQL, aSel, aRows, i, oRow, sGuidName, sDateFormat;
oResponse := CreateUDObject({
	{"success", .T.},
	{"data", NIL}
});

:IF !Request:QueryString:IsProperty("URI") .OR. Empty(Request:QueryString:URI);
	Response:StatusCode := 400;
	oResponse:success := .F.;
	oResponse:data := "Missing required parameter: URI";
	:RETURN oResponse;
:ENDIF;
sURI := Request:QueryString:URI;

:TRY;
	oUtils := CreateUDObject("SCM_API.Utils", {});
	oEnterpriseItem := oUtils:ParseURI(sURI);
	sItemName := BuildArray(oEnterpriseItem:Name,, ".")[1];
	sItemType := oEnterpriseItem:Type;

	:BEGINCASE;
		:CASE sItemType == "SS" .OR. sItemType == "CS" .OR. sItemType == "DS";
			sGuidName := oEnterpriseItem:CategoryName + "." + sItemName;
		:EXITCASE;
		:OTHERWISE;
			sGuidName := oEnterpriseItem:AppName + "." + sItemName;
	:ENDCASE;
	sItemID := oUtils:GetItemGUID(sGuidName, sItemType);

	:IF Empty(sItemID);
		oResponse:success := .F.;
		oResponse:data := "Item not found: " + sURI;
		:RETURN oResponse;
	:ENDIF;

	/* Platform specific date formatting */;
	:BEGINCASE;
		:CASE PLATFORMA == "ORACLE";
			sDateFormat := "TO_CHAR(LBL.CREATED_DT, 'YYYY-MM-DD HH24:MI:SS')";
		:EXITCASE;
		:OTHERWISE;
			sDateFormat := "convert(varchar(19), LBL.CREATED_DT, 120)";
	:ENDCASE;

	sSQL := "select LBL.LABEL_TITLE, LBL.LABEL_DESC, LBL.CREATED_BY, " + sDateFormat + " AS CREATED_DT, ITM.ITEM_VERSIONID " +
			"from VERSIONSLABELS LBL, VERSIONSLABELS_ITEMS ITM " +
			"where LBL.LABEL_ID = ITM.LABEL_ID " +
			"and ITM.ITEM_GUID = '" + sItemID + "' " +
			"order by LBL.ORIGREC DESC";

	aSel := SQLExecute(sSQL, "DICTIONARY");

	aRows := {};
	:FOR i := 1 :TO Len(aSel);
		oRow := CreateUDObject({
			{"LABEL_TITLE", aSel[i,1]},
			{"LABEL_DESC", aSel[i,2]},
			{"CREATED_BY", aSel[i,3]},
			{"CREATED_DT", aSel[i,4]},
			{"ITEM_VERSIONID", aSel[i,5]}
		});
		AAdd(aRows, oRow);
	:NEXT;

	Response:StatusCode := 200;
	oResponse:success := .T.;
	oResponse:data := aRows;
	:RETURN oResponse;
:CATCH;
	Response:StatusCode := 500;
	oResponse:success := .F.;
	oResponse:data := "GetItemLabels error: " + ErrorMessage();
	:RETURN oResponse;
:ENDTRY;
