{
  "name": "starlims-devtools",
  "version": "1.7.0-beta.6",
  "description": "Cross-platform STARLIMS Development Tools with MCP integration | 跨平台 STARLIMS 开发工具",
  "main": "dist-electron/main.js",
  "author": "STARLIMS DevTools Team",
  "repository": "https://github.com/tenlyc/starlims-devtools",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prepare:lsp": "node scripts/prepare-starlims-lsp.mjs",
    "upstream:check": "node scripts/upstreams/check-updates.mjs",
    "upstream:update:lsp": "node scripts/upstreams/update-starlims-lsp.mjs",
    "upstream:audit:starlimsvscode": "node scripts/upstreams/audit-starlimsvscode.mjs",
    "upstream:accept:starlimsvscode": "node scripts/upstreams/accept-starlimsvscode.mjs",
    "build": "npm run build:scm-api && npm run prepare:lsp && tsc && vite build && electron-builder",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "rebuild": "npm run clean:build && npm run build",
    "build:scm-api": "node scripts/build-scm-api-package.mjs",
    "build:vite": "tsc && vite build",
    "test:mcp": "tsx scripts/mcp-smoke-test.ts",
    "test:table-readback": "tsx scripts/table-readback-smoke-test.ts",
    "test:mcp-live": "node scripts/live-mcp-smoke-test.mjs",
    "test:shared-mcp": "tsx scripts/shared-mcp-runtime-smoke-test.ts",
    "test:shared-mcp-fallback": "tsx scripts/shared-mcp-fallback-smoke-test.ts",
    "test:shared-mcp-package": "tsx scripts/shared-mcp-package-runtime-smoke-test.ts",
    "test:form-resources-live": "node scripts/live-form-resources-binding-acceptance.mjs",
    "test:form-resources": "tsx scripts/form-resources-mcp-smoke-test.ts",
    "test:form-preview": "tsx scripts/form-preview-smoke-test.ts",
    "test:ssl": "tsx scripts/ssl-lsp-smoke-test.ts",
    "test:ssl-package": "tsx scripts/ssl-lsp-package-runtime-smoke-test.ts",
    "test:ssl-upstream": "tsx scripts/starlims-lsp-upstream-smoke-test.ts",
    "test:ssl-session": "tsx scripts/ssl-lsp-session-smoke-test.ts",
    "test:upstreams": "tsx scripts/upstream-management-smoke-test.ts",
    "test:server-config": "tsx scripts/server-config-smoke-test.ts",
    "test:ai-context": "tsx scripts/ai-context-smoke-test.ts",
    "test:dependency-index": "tsx scripts/dependency-index-smoke-test.ts",
    "test:ai-platform": "tsx scripts/ai-platform-smoke-test.ts",
    "test:write-gate": "tsx scripts/write-gate-smoke-test.ts",
    "test:agent-runtime": "tsx scripts/agent-runtime-smoke-test.ts",
    "test:agent-observability": "tsx scripts/agent-observability-smoke-test.ts",
    "test:agent-workspace": "tsx scripts/agent-workspace-smoke-test.ts",
    "test:editor-languages": "tsx scripts/editor-language-smoke-test.ts",
    "test:context-menu": "tsx scripts/context-menu-smoke-test.ts",
    "test:checkout-forms": "tsx scripts/checkout-form-smoke-test.ts",
    "test:enterprise-search-tree": "tsx scripts/enterprise-search-tree-smoke-test.ts",
    "test:i18n": "tsx scripts/i18n-smoke-test.ts",
    "test:scm-export": "tsx scripts/scm-export-smoke-test.ts",
    "test:bottom-panel": "tsx scripts/bottom-panel-smoke-test.ts",
    "test:smoke": "node scripts/run-smoke-tests.mjs",
    "check": "npm run prepare:lsp && npm run lint && npm run build:vite && npm run test:smoke",
    "preview": "vite preview",
    "electron:dev": "npm run prepare:lsp && concurrently \"vite\" \"electron .\"",
    "lint": "eslint src --ext ts,tsx",
    "lint:baseline": "node scripts/check-eslint-baseline.mjs",
    "test:mcp-live-write": "node scripts/live-mcp-write-acceptance.mjs",
    "release:beta:check": "node scripts/beta-release-check.mjs",
    "test:menu-mcp": "tsx scripts/menu-mcp-smoke-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.6.0",
    "@tenlyc/starlims-mcp": "https://github.com/tenlyc/starlims-mcp/archive/refs/tags/v0.5.2.tar.gz",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "dompurify": "^3.4.14",
    "electron-log": "^5.0.0",
    "electron-store": "^8.1.0",
    "express": "^5.2.1",
    "jsdom": "^22.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-languageserver-types": "^3.18.3",
    "zod": "^4.5.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.14"
    }
  },
  "build": {
    "appId": "com.starlims.devtools",
    "productName": "STARLIMS DevTools",
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src/scm_api",
        "to": "scm_api"
      },
      {
        "from": "resources/starlims-lsp",
        "to": "resources/starlims-lsp"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "mac": {
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "forceCodeSigning": false
  }
}
